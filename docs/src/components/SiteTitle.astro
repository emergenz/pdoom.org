---
const orgHome = '/';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsHome = base + '/';
const mark = base + '/assets/pdoom-mark-128.webp';
---

<div class="site-title">
  <a href={orgHome} class="cc-org" aria-label="p(doom) home">
    <img src={mark} alt="" class="cc-logo" width="128" height="128" decoding="async" />
    <span class="cc-wordmark">p(doom)</span>
  </a>
  <span class="cc-sep" aria-hidden="true"></span>
  <a href={docsHome} class="cc-docs">
    <span>crowd-cast</span>
    <small>documentation</small>
  </a>
</div>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    white-space: nowrap;
  }

  .cc-org {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .cc-logo {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
  }

  .cc-wordmark {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
  }

  .cc-sep {
    width: 1px;
    height: 1.75rem;
    background: var(--sl-color-hairline-shade);
  }

  .cc-docs {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--sl-color-white);
    font-family: var(--sl-font);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
  }

  .cc-docs small {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cc-org:hover .cc-wordmark,
  .cc-docs:hover {
    color: var(--sl-color-text-accent);
  }

  @media (max-width: 50rem) {
    .cc-wordmark {
      display: none;
    }

    .site-title {
      gap: 0.625rem;
    }

    .cc-logo {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
