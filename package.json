{
  "name": "pdoom-landing-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:docs && vite",
    "dev:site": "vite",
    "dev:docs": "npm --prefix docs run dev -- --host 127.0.0.1",
    "build": "npm run build:site && npm run build:docs && npm run build:pages",
    "build:site": "vite build",
    "build:docs": "npm --prefix docs run build",
    "build:pages": "node scripts/prepare-pages.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@orcid/bibtex-parse-js": "^0.0.25",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@vitejs/plugin-react": "latest",
    "katex": "^0.16.47",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest"
  }
}
